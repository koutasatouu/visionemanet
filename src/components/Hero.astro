---
import DarkVeil from "./reactbits/DarkVeil.tsx";
import SplitText from "./reactbits/SplitText.tsx";
import VisionemaLogo from "./VisionemaLogo.tsx";
---

<section
  id="hero"
  class="relative h-screen w-full bg-background overflow-hidden flex items-center justify-center"
>
  <div class="absolute inset-0 z-0">
    <DarkVeil
      client:visible
      speed={0.2}
      noiseIntensity={0.03}
      scanlineIntensity={0.05}
    />
  </div>

  <div
    class="relative z-10 mx-auto flex h-full w-full max-w-360 flex-col justify-center px-6 text-center items-center sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550"
  >
    <!-- Animated Logo in Hero Center -->
    <div
      class="mb-8 animate-fade-in opacity-0"
      style="animation: fadeIn 1s ease-out forwards;"
    >
      <VisionemaLogo className="h-28 sm:h-36 w-auto drop-shadow-xl" />
    </div>

    <h1
      class="text-[clamp(2.75rem,6.5vw,9rem)] leading-[1.05] tracking-tight text-foreground font-extrabold select-none mb-6"
    >
      <SplitText text="Mulai, Tumbuh, dan" client:visible delay={0.2} /><br />
      <span class="font-serif italic font-normal text-accent drop-shadow-sm">
        <SplitText text="Menang Bareng! " client:visible delay={0.5} />
      </span>
    </h1>

    <p
      class="max-w-2xl text-[clamp(1.1rem,1.3vw,1.5rem)] leading-relaxed text-foreground/80 animate-fade-in opacity-0"
      style="animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;"
    >
      Sosmed lu gitu-gitu aja? Tenang, kita ngga cuma sekadar upload konten
      terus ditinggal. Kita racik visual, skrip, dan strategi yang bikin audiens
      betah sama brand lu.
    </p>

    <div
      class="mt-10 animate-fade-in opacity-0"
      style="animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) 1.1s forwards;"
    >
      <a href="#packages" class="group btn-cta-blue px-8 py-4 text-base sm:text-lg">
        <div class="shimmer-sweep"></div>
        <span class="relative z-20">Cek Paket Seru Kita</span>
        <span class="btn-arrow-capsule group-hover:text-[#2563eb]">
          <svg class="w-4 h-4 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <div
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 w-full max-w-360 px-6 sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550 flex justify-between items-center opacity-70"
  >
    <span class="text-xs uppercase tracking-widest font-mono text-foreground/60">
      Start, Grow, Win!
    </span>
    <span class="text-xs uppercase tracking-widest font-mono text-foreground/60">
      Visionema © 2026
    </span>
  </div>
</section>
