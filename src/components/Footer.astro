---

<footer
  id="contact"
  class="bg-white/[0.02] text-foreground border-t border-white/5"
>
  <!-- Contact Action -->
  <div
    class="px-6 sm:px-12 lg:px-24 pt-24 lg:pt-32 pb-16 lg:pb-24 text-center sm:text-left max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto"
  >
    <a
      href="mailto:admin@visionema.net"
      class="text-[clamp(1.5rem,6vw,5.5rem)] font-bold tracking-tight hover:text-accent transition-colors break-all"
    >
      admin@visionema.net
    </a>
    <div class="mt-10">
      <a
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-full bg-accent text-white hover:bg-accent/90 transition-colors shadow-lg shadow-accent/20"
        href="https://wa.me/6281234567890"
        target="_blank"
        rel="noopener noreferrer"
      >
        Mulai Diskusi Project
      </a>
    </div>
  </div>

  <div
    class="px-6 sm:px-12 lg:px-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto"
  >
    <div class="border-t border-white/10"></div>
  </div>

  <!-- Details Columns -->
  <div
    class="px-6 sm:px-12 lg:px-24 py-16 lg:py-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
      <div class="lg:col-span-4">
        <span class="text-3xl font-extrabold tracking-tight">visionema.net</span
        >
        <p class="mt-4 text-foreground/60 text-lg">
          Mulai, Tumbuh, dan Menang Bareng.
        </p>
      </div>

      <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-8">
        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-6 font-mono"
          >
            Lokasi
          </h4>
          <div class="space-y-4">
            <div>
              <p class="font-medium text-sm text-foreground">Indonesia</p>
              <p class="text-foreground/60 text-xs mt-1">
                Remote & Hybrid Team
              </p>
            </div>
          </div>
        </div>

        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-6 font-mono"
          >
            Layanan
          </h4>
          <ul class="space-y-3 text-sm text-foreground/60">
            <li>Social Media Management</li>
            <li>Content Creation</li>
            <li>Visual Branding</li>
            <li>Copywriting / Scripting</li>
          </ul>
        </div>

        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-6 font-mono"
          >
            Navigasi
          </h4>
          <ul class="space-y-3 text-sm">
            <li>
              <a
                class="text-foreground/60 hover:text-foreground transition-colors"
                href="#">Beranda</a>
            </li>
            <li>
              <a
                class="text-foreground/60 hover:text-foreground transition-colors"
                href="#projects">Portofolio</a>
            </li>
            <li>
              <a
                class="text-foreground/60 hover:text-foreground transition-colors"
                href="#packages">Paket Layanan</a>
            </li>
            <li>
              <a
                class="text-foreground/60 hover:text-foreground transition-colors"
                href="#about">Tentang</a>
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-6 font-mono"
          >
            Media Sosial
          </h4>
          <ul class="space-y-3 text-sm">
            <li>
              <a
                href="https://instagram.com/visionema_net"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground/60 hover:text-foreground transition-colors"
                >Instagram</a>
            </li>
            <li>
              <a
                href="https://lynk.id/visionema.id"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground/60 hover:text-foreground transition-colors"
                >Lynk.id</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div
    class="px-6 sm:px-12 lg:px-24 py-8 border-t border-white/5 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto"
  >
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-foreground/40"
    >
      <div class="flex items-center gap-6">
        <a class="hover:text-foreground transition-colors" href="#about"
          >Tentang Kami</a
        >
        <a class="hover:text-foreground transition-colors" href="#projects"
          >Portofolio</a
        >
        <a class="hover:text-foreground transition-colors" href="#contact"
          >Kontak</a
        >
      </div>
      <p>© 2026 Visionema.net - Hak Cipta Dilindungi</p>
    </div>
  </div>
</footer>
