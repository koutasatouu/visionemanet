---
const processes = [
  {
    title: "Pra Produksi",
    desc: "Riset mendalam target audiens, penyusunan pilar konten strategis, serta perancangan naskah kreatif dengan hook yang memikat sejak detik pertama.",
  },
  {
    title: "Produksi",
    desc: "Eksekusi visual berstandar tinggi: pengambilan footage sinematik, visual B-Roll estetik, serta desain tata letak konten yang profesional.",
  },
  {
    title: "Post Produksi",
    desc: "Sentuhan pascaproduksi lengkap: video editing dinamis, color grading sinematik, sound design presisi, serta copywriting caption yang relevan.",
  },
  {
    title: "Maintenance & Growth",
    desc: "Publikasi terjadwal yang konsisten, interaksi responsif dengan audiens, serta laporan analitik performa bulanan untuk mengukur pertumbuhan bisnis Anda.",
  },
];
---

<section
  id="services"
  class="services relative bg-background overflow-hidden border-t border-white/5 py-24"
>
  <div
    class="mx-auto max-w-360 px-6 sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550"
  >
    <!-- Large statement heading -->
    <div
      class="flex min-h-[25vh] items-center justify-center text-center py-10"
    >
      <h2
        class="text-[clamp(2.25rem,5vw,5rem)] font-extrabold leading-[1.1] tracking-tight text-foreground max-w-4xl"
      >
        Alur Kerja & <span class="font-serif italic font-normal text-foreground">Proses Kami</span>
      </h2>
    </div>

    <!-- Hover menu list -->
    <div class="w-full mt-8 border-t border-white/10 divide-y divide-white/10">
      {
        processes.map((proc, index) => (
          <div class="group relative overflow-hidden transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-center justify-between cursor-pointer px-4 py-8 sm:px-8 md:py-10 hover:bg-white/[0.02]">
              <div class="flex items-center gap-4">
                <span class="text-lg font-mono font-bold uppercase tracking-widest text-blue-400/80">
                  0{index + 1}
                </span>
                <span class="text-[clamp(1.5rem,3vw,3.25rem)] font-bold tracking-tight text-foreground transition-transform duration-300 group-hover:translate-x-2">
                  {proc.title}
                </span>
              </div>
              <p class="mt-4 md:mt-0 text-foreground/75 max-w-md text-base leading-relaxed md:opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                {proc.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
