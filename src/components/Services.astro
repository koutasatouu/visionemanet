---
const processes = [
  {
    title: "Pra Produksi",
    desc: "Biar gak asal ngonten, kita kulik audiens lu, susun pilar konten yang pas, sampe racik hook skrip yang bikin orang gak skip.",
  },
  {
    title: "Produksi",
    desc: "Eksekusi visual gak main-main! Dari shoot sinematik, B-Roll aesthetic yang memanjakan mata, sampe desain carousel berkelas.",
  },
  {
    title: "Post Produksi",
    desc: "Tahap sulap konten! Video editing dinamis, grading warna cakep, sound design pas, plus caption & hashtag yang relevan abis.",
  },
  {
    title: "Maintenance",
    desc: "Jadwal posting aman terjaga, DM & komentar kita pantau ramah, plus laporan performa bulanan biar tahu progres naiknya.",
  },
];
---

<section
  id="services"
  class="services relative bg-background overflow-hidden border-t border-white/5 py-24"
>
  <div
    class="mx-auto max-w-360 px-6 sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550"
  >
    <!-- Large statement heading -->
    <div
      class="flex min-h-[25vh] items-center justify-center text-center py-10"
    >
      <h2
        class="text-[clamp(2.25rem,5vw,5rem)] font-extrabold leading-[1.1] tracking-tight text-foreground max-w-4xl"
      >
        Apa sih yang <span
          class="font-serif italic bg-gradient-to-r from-accent to-accent-yellow bg-clip-text font-normal"
          >kami kerjain?</span
        >
      </h2>
    </div>

    <!-- Hover menu list -->
    <div class="w-full mt-8 border-t border-white/10 divide-y divide-white/10">
      {
        processes.map((proc, index) => (
          <div class="group relative overflow-hidden transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-center justify-between cursor-pointer px-4 py-8 sm:px-8 md:py-10 hover:bg-white/[0.02]">
              <div class="flex items-center gap-4">
                <span class="text-lg font-mono font-bold uppercase tracking-widest text-accent/70">
                  0{index + 1}
                </span>
                <span class="text-[clamp(1.5rem,3vw,3.25rem)] font-bold tracking-tight text-foreground transition-transform duration-300 group-hover:translate-x-2">
                  {proc.title}
                </span>
              </div>
              <p class="mt-4 md:mt-0 text-foreground/75 max-w-md text-base leading-relaxed md:opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                {proc.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
