---
const packages = [
  {
    id: "mulai-aja-dulu",
    name: "Mulai Aja Dulu...",
    price: "Rp 2.699k",
    tagline: "Membangun Kehadiran & Konsistensi Digital",
    popular: false,
    content: [
      "8 Video Estetik",
      "4 Foto Feed HT",
      "Desain Carousel Interaktif"
    ],
    highlightToppings: [
      "Jadwal Publikasi & Copywriting Rapi",
      "Setup & Optimasi Profil Awal"
    ],
    moreToppings: [
      "Laporan Performa Bulanan Ringkas",
      "Aesthetic B-Roll (Tanpa Naskah)"
    ]
  },
  {
    id: "level-up",
    name: "Level Up!",
    price: "Rp 4.699k",
    tagline: "Paling Favorit! Tingkatkan Engagement & Konversi",
    popular: true,
    content: [
      "12 Video Pendek (Hook Kuat)",
      "8 Foto Feed Profesional",
      "2 Desain Carousel Edukatif"
    ],
    highlightToppings: [
      "Pengelolaan Akun Menyeluruh",
      "Manajemen DM & Komentar",
      "Optimasi Profil & Branding Terarah"
    ],
    moreToppings: [
      "Aesthetic B-Roll Cinematic",
      "Naskah Strategis (Hook & CTA)",
      "Jadwal Publikasi & Copywriting Menjual",
      "Laporan Bulanan Komprehensif",
      "Analisis Performa & Strategi Bulanan",
      "Pilar Konten Kustom Sesuai Niche",
      "Interaksi Proaktif ke Target Audiens",
      "Optimasi SEO Media Sosial & Sorotan"
    ]
  },
  {
    id: "scale-up",
    name: "Scale Up!",
    price: "Rp 8.699k",
    tagline: "Maksimal! Dominasi Pasar & Penjualan",
    popular: false,
    content: [
      "20 Video Sinematik Premium",
      "12 Foto Feed Eksklusif",
      "4 Desain Carousel Edukatif"
    ],
    highlightToppings: [
      "Pengelolaan Akun Dedicated",
      "Setup & Revamp Branding",
      "Dashboard KPI & Audit Brand Bulanan"
    ],
    moreToppings: [
      "Aesthetic B-Roll Cinematic",
      "Naskah Strategis & Storytelling Mendalam",
      "Arahan Visual & Brand Narrative",
      "Jadwal Publikasi & Copywriting Eksklusif",
      "Laporan Analitik Mendalam & Rekomendasi",
      "Manajemen Respons Cepat DM & Komentar",
      "Riset Tren & Strategi Bertumbuh",
      "Pilar Konten Komprehensif",
      "Interaksi Proaktif Maksimal",
      "Optimasi SEO Media Sosial Lengkap"
    ]
  }
];
---

<section id="packages" class="py-16 sm:py-24 bg-background border-t border-white/5">
  <div class="px-6 sm:px-12 lg:px-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs uppercase font-mono tracking-widest text-blue-400 font-bold">Investasi Pintar</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground mt-4">
        Paket Pengelolaan <span class="font-serif italic font-normal text-foreground">Media Sosial</span>
      </h2>
      <p class="text-foreground/75 mt-4 text-base sm:text-lg">
        Pilih paket yang paling sesuai untuk mengakselerasi pertumbuhan brand Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      {packages.map((pkg) => (
        <div class={`relative transition-all duration-300 ${pkg.popular ? 'lg:scale-105 z-10' : ''}`}>
          {pkg.popular && (
            <div class="glow-border-container">
              <div class="glow-border-beam"></div>
              <div class="glow-border-content">
                <span>Paling Favorit</span>
              </div>
            </div>
          )}

          <div class={`relative w-full h-full rounded-[2.5rem] p-[1.5px] overflow-hidden ${pkg.popular ? 'glow-card-container' : 'bg-white/5 border border-white/10 hover:shadow-2xl'}`}>
            {pkg.popular && <div class="glow-card-beam"></div>}
            
            <div class={`relative w-full h-full rounded-[2.5rem] p-6 sm:p-8 flex flex-col justify-between ${pkg.popular ? 'bg-[#121217]' : ''}`}>
              <div>
                <!-- Header Kartu -->
                <div class="text-center pb-6 border-b border-white/10">
                  <h3 class="text-2xl font-bold text-foreground">{pkg.name}</h3>
                  <p class="text-xs font-semibold text-blue-400 mt-1">{pkg.tagline}</p>
                  <div class="mt-4 flex items-baseline justify-center text-foreground">
                    <span class="text-3xl sm:text-4xl font-extrabold tracking-tight">{pkg.price}</span>
                    <span class="ml-1 text-xs sm:text-sm font-semibold text-foreground/60">/ bulan</span>
                  </div>
                </div>

                <!-- Ringkasan Fitur Utama -->
                <div class="mt-6 space-y-5">
                  <!-- Deliverables / Ringkasan Jumlah Konten -->
                  <div class="bg-white/5 rounded-2xl p-4 border border-white/5">
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-blue-400 font-mono mb-2">Deliverables Utama</h4>
                    <ul class="space-y-1.5 text-xs text-foreground/90 font-medium">
                      {pkg.content.map((item) => (
                        <li class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Highlight Fasilitas Utama -->
                  <div>
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-foreground/40 mb-2 font-mono">Highlight Layanan</h4>
                    <ul class="space-y-2 text-xs text-foreground/80 font-medium">
                      {pkg.highlightToppings.map((item) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Read More Extra Features (Sembunyi secara default) -->
                  <div id={`more-${pkg.id}`} class="hidden pt-2 space-y-2 border-t border-white/5">
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-foreground/40 mb-2 font-mono">Fasilitas Lainnya</h4>
                    <ul class="space-y-2 text-xs text-foreground/70">
                      {pkg.moreToppings.map((item) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-3.5 h-3.5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Read More Toggle Button -->
                <button 
                  type="button" 
                  data-target={`more-${pkg.id}`}
                  class="toggle-more-btn w-full mt-4 py-2 px-3 rounded-xl bg-white/5 hover:bg-white/10 text-[11px] font-semibold text-blue-400 flex items-center justify-center gap-1.5 transition-all duration-200"
                >
                  <span class="btn-text">Selengkapnya ({pkg.moreToppings.length}+ fitur)</span>
                  <svg class="chevron-icon w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
              </div>

              <!-- CTA Button -->
              <div class="mt-6 pt-5 border-t border-white/10">
                <a 
                  href={`https://wa.me/6287829947598?text=${encodeURIComponent(`Halo Visionema, saya tertarik untuk berkonsultasi mengenai paket ${pkg.name}.`)}`} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class={pkg.popular ? 'group btn-cta-orange w-full py-3.5 text-sm' : 'group btn-card-standard w-full py-3 text-sm'}
                >
                  <div class="shimmer-sweep"></div>
                  <span class="relative z-20">Pilih Paket Ini</span>
                  <span class={`relative z-20 w-5 h-5 rounded-full flex items-center justify-center transition-all duration-300 ${pkg.popular ? 'bg-white/20 text-white group-hover:bg-white group-hover:text-[#ff7000] group-hover:translate-x-1 shadow-inner' : 'bg-white/10 text-foreground/70 group-hover:bg-accent group-hover:text-white group-hover:translate-x-1'}`}>
                    <svg class="w-3 h-3 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.toggle-more-btn');

    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        const targetEl = document.getElementById(targetId);
        const btnText = btn.querySelector('.btn-text');
        const chevron = btn.querySelector('.chevron-icon');

        if (targetEl && btnText && chevron) {
          const isHidden = targetEl.classList.contains('hidden');

          if (isHidden) {
            targetEl.classList.remove('hidden');
            btnText.textContent = 'Ringkaskan';
            chevron.classList.add('rotate-180');
          } else {
            targetEl.classList.add('hidden');
            const count = targetEl.querySelectorAll('li').length;
            btnText.textContent = `Selengkapnya (${count}+ fitur)`;
            chevron.classList.remove('rotate-180');
          }
        }
      });
    });
  });
</script>