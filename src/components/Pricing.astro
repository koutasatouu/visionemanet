---
const packages = [
  {
    name: "Mulai Aja Dulu...",
    price: "Rp 2.699k",
    tagline: "Membangun Kehadiran & Konsistensi Digital",
    popular: false,
    content: [
      "8 Video Estetik",
      "4 Foto Feed Berkualitas Tinggi",
      "Desain Carousel Interaktif"
    ],
    types: [
      "Aesthetic B-Roll (Tanpa Naskah)"
    ],
    toppings: [
      "Jadwal Publikasi & Copywriting Rapi",
      "Setup & Optimasi Profil Awal",
      "Laporan Performa Bulanan Ringkas"
    ]
  },
  {
    name: "Level Up!",
    price: "Rp 4.699k",
    tagline: "Paling Favorit! Tingkatkan Engagement & Konversi",
    popular: true,
    content: [
      "12 Video Pendek dengan Hook Kuat",
      "8 Foto Feed Profesional",
      "2 Desain Carousel Edukatif"
    ],
    types: [
      "Aesthetic B-Roll Cinematic",
      "Naskah Strategis (Hook & Call to Action)"
    ],
    toppings: [
      "Jadwal Publikasi & Copywriting Menjual",
      "Optimasi Profil & Branding Terarah",
      "Laporan Bulanan Komprehensif",
      "Pengelolaan Akun Menyeluruh",
      "Manajemen Respons Ramah untuk DM & Komentar",
      "Analisis Performa & Strategi Bulanan",
      "Pilar Konten Kustom Sesuai Niche",
      "Interaksi Proaktif ke Target Audiens",
      "Optimasi SEO Media Sosial & Sorotan"
    ]
  },
  {
    name: "Scale Up!",
    price: "Rp 8.699k",
    tagline: "Maksimal! Dominasi Pasar & Tingkatkan Penjualan",
    popular: false,
    content: [
      "20 Video Sinematik Premium",
      "12 Foto Feed Eksklusif",
      "4 Desain Carousel Edukatif Mendalam"
    ],
    types: [
      "Aesthetic B-Roll Cinematic",
      "Naskah Strategis & Storytelling Mendalam",
      "Arahan Visual & Brand Narrative"
    ],
    toppings: [
      "Jadwal Publikasi & Copywriting Eksklusif",
      "Setup & Revamp Branding Komprehensif",
      "Laporan Analitik Mendalam & Rekomendasi",
      "Pengelolaan Akun Dedicated",
      "Manajemen Respons Cepat DM & Komentar",
      "Riset Tren & Strategi Bertumbuh",
      "Pilar Konten Komprehensif",
      "Interaksi Proaktif Maksimal",
      "Optimasi SEO Media Sosial Lengkap",
      "Dashboard Monitoring KPI",
      "Konsultasi & Audit Brand Bulanan"
    ]
  }
];
---

<section id="packages" class="py-24 bg-background border-t border-white/5">
  <div class="px-6 sm:px-12 lg:px-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs uppercase font-mono tracking-widest text-blue-400 font-bold">Investasi Pintar</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground mt-4">
        Paket Pengelolaan <span class="font-serif italic font-normal text-foreground">Media Sosial</span>
      </h2>
      <p class="text-foreground/75 mt-4 text-base sm:text-lg">
        Pilih paket yang paling sesuai untuk mengakselerasi kehadiran dan pertumbuhan brand Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      {packages.map((pkg) => (
        <div class={`relative transition-all duration-300 ${pkg.popular ? 'lg:scale-105 z-10' : ''}`}>
          {pkg.popular && (
            <div class="glow-border-container">
              <div class="glow-border-beam"></div>
              <div class="glow-border-content">
                <span>Paling Favorit</span>
              </div>
            </div>
          )}

          <div class={`relative w-full h-full rounded-[2.5rem] p-[1.5px] overflow-hidden ${pkg.popular ? 'glow-card-container' : 'bg-white/5 border border-white/10 hover:shadow-2xl'}`}>
            {pkg.popular && <div class="glow-card-beam"></div>}
            
            <div class={`relative w-full h-full rounded-[2.5rem] p-8 sm:p-10 flex flex-col justify-between ${pkg.popular ? 'bg-[#121217]' : ''}`}>
              <div>
                <div class="text-center pb-6 border-b border-white/10">
                  <h3 class="text-2xl font-bold text-foreground">{pkg.name}</h3>
                  <p class="text-sm font-semibold text-blue-400 mt-1">{pkg.tagline}</p>
                  <div class="mt-4 flex items-baseline justify-center text-foreground">
                    <span class="text-4xl font-extrabold tracking-tight">{pkg.price}</span>
                    <span class="ml-1 text-sm font-semibold text-foreground/60">/ bulan</span>
                  </div>
                </div>

                <!-- Content list -->
                <div class="mt-8 space-y-6">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-3 font-mono">Jumlah Konten</h4>
                    <ul class="space-y-2 text-sm text-foreground/90 font-medium">
                      {pkg.content.map((item) => (
                        <li class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-3 font-mono">Tipe Produksi</h4>
                    <ul class="space-y-2 text-sm text-foreground/90 font-medium">
                      {pkg.types.map((item) => (
                        <li class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-foreground/40 mb-3 font-mono">Layanan & Fasilitas</h4>
                    <ul class="space-y-2 text-xs text-foreground/75 font-semibold">
                      {pkg.toppings.map((item) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10">
                <a 
                  href={`https://wa.me/6281234567890?text=${encodeURIComponent(`Halo Visionema, saya tertarik untuk berkonsultasi mengenai paket ${pkg.name}.`)}`} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class={pkg.popular ? 'group btn-cta-orange w-full py-4 text-base' : 'group btn-card-standard w-full'}
                >
                  <div class="shimmer-sweep"></div>
                  <span class="relative z-20">Pilih Paket Ini</span>
                  <span class={`relative z-20 w-6 h-6 rounded-full flex items-center justify-center transition-all duration-300 ${pkg.popular ? 'bg-white/20 text-white group-hover:bg-white group-hover:text-[#ff7000] group-hover:translate-x-1 shadow-inner' : 'bg-white/10 text-foreground/70 group-hover:bg-accent group-hover:text-white group-hover:translate-x-1'}`}>
                    <svg class="w-3 h-3 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
