---
import video01 from "../assets/video/01.mp4";
import video04 from "../assets/video/bts.mp4";
import tetraImg from "../assets/web_thumbnail/tetra.png";
import buraImg from "../assets/web_thumbnail/burabura.png";
import zanoidImg from "../assets/web_thumbnail/zanoid.png";
import ProjectModal from "./ProjectModal.astro";
import AnimatedContent from "./reactbits/AnimatedContent";

const webProjects = [
  {
    title: "Tetra Coffee House",
    category: "WEB DEV & DESIGN",
    image: tetraImg.src,
    link: "https://tetracoffee.vercel.app/",
    tags: ["REACT.JS", "TAILWIND CSS", "NEXT.JS"],
    color: "from-blue-600/20 to-indigo-600/10"
  },
  {
    title: "Bura Bura Coffee",
    category: "WEB DEV & DESIGN",
    image: buraImg.src,
    link: "https://buraburacoffee.vercel.app/",
    tags: ["REACT.JS", "TAILWIND CSS", "FRAMER MOTION"],
    color: "from-blue-600/20 to-cyan-600/10"
  },
  {
    title: "Zanoid",
    category: "WEB DEV & DESIGN",
    image: zanoidImg.src,
    link: "https://zanoid.vercel.app/",
    tags: ["STARTUP", "VITE", "TAILWIND CSS"],
    color: "from-indigo-600/20 to-blue-600/10"
  }
];

interface ProjectItem {
  num: string;
  title: string;
  category: string;
  desc?: string;
  color?: string;
  video?: any;
  isWebGrid?: boolean;
}

const projects: ProjectItem[] = [
  {
    num: "01",
    title: "Brand Motion & Identity",
    category: "Motion Graphic",
    desc: "Animasi motion graphic dinamis yang memvisualisasikan perjalanan dan identitas brand partner bersama Visionema secara elegan & engaging.",
    color: "from-blue-600/10 to-purple-600/10",
    video: video01
  },
  {
    num: "02",
    title: "Web & App Productions",
    category: "Web Dev & Design",
    isWebGrid: true
  },
  {
    num: "03",
    title: "Branding Correctly",
    category: "Desain Edukatif",
    desc: "Microblog & carousel edukasi padat insight yang gampang dicerna, bikin brand lu dipercaya jadi panutan di industri.",
    color: "from-emerald-600/10 to-teal-600/10"
  },
  {
    num: "04",
    title: "Standar Film Production",
    category: "Konten Sinematik",
    desc: "Bikin konten reels & video sosmed dengan rasa film layar lebar. Visual mahal yang langsung ngangkat kelas brand lu.",
    color: "from-rose-600/10 to-indigo-600/10",
    video: video04
  }
];
---

<section id="projects" class="projects bg-background relative border-t border-white/5">
  <!-- Marquee Header -->
  <div class="py-24 overflow-hidden select-none touch-pan-y bg-foreground text-background">
    <div class="flex whitespace-nowrap marquee-track touch-pan-y">
      {Array(4).fill(0).map(() => (
        <span class="shrink-0 text-[clamp(3.5rem,8vw,10rem)] font-extrabold tracking-tight text-background uppercase px-8">
          Portofolio <span class="font-serif font-thin italic text-background/60">Pilihan</span>
        </span>
      ))}
    </div>
  </div>

  <div class="flex flex-col divide-y divide-white/5">
    {projects.map((proj) => (
      proj.isWebGrid ? (
        <!-- Item 02: Ultra-Sleek Minimalist Web Portfolio Grid (3 Selected Works) -->
        <div class="py-16 md:py-24 bg-white/[0.01]">
          <div class="mx-auto max-w-360 px-6 sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550">
            
            <!-- Header for 02 -->
            <AnimatedContent distance={60} direction="vertical" duration={0.8} threshold={0.15} client:visible>
              <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
                <div>
                  <span class="text-sm font-semibold uppercase tracking-widest text-blue-400 font-mono block mb-3">02 — WEB DEV & DESIGN</span>
                  <h3 class="text-[clamp(2.25rem,4vw,4.5rem)] leading-[1.05] tracking-tight text-foreground font-extrabold">
                    Web & App <span class="font-serif italic font-normal text-foreground">Productions</span>
                  </h3>
                </div>
                <p class="text-foreground/70 text-sm sm:text-base max-w-md leading-relaxed">
                  Bukan cuma sosmed, kita juga bikinin website interaktif dan landing page estetik yang siap konversi audiens jadi pelanggan setia.
                </p>
              </div>
            </AnimatedContent>

            <!-- 3-Column Minimalist Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {webProjects.map((webProj) => (
                <AnimatedContent distance={40} direction="vertical" duration={0.7} threshold={0.1} client:visible>
                  <a
                    href={webProj.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative bg-white/[0.03] border border-white/10 hover:border-blue-500/50 rounded-2xl sm:rounded-3xl p-5 sm:p-6 flex flex-col justify-between transition-all duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-blue-500/5 backdrop-blur-sm cursor-pointer overflow-hidden block"
                  >
                    <!-- Ambient Glow on hover -->
                    <div class="absolute -right-12 -top-12 w-36 h-36 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all duration-500 pointer-events-none" />

                    <div>
                      <!-- Top Category Tag -->
                      <div class="flex items-center justify-between mb-4">
                        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-blue-400 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20">
                          {webProj.category}
                        </span>
                      </div>

                      <!-- Website Thumbnail Frame -->
                      <div class="relative aspect-16/10 w-full overflow-hidden rounded-xl bg-white/5 border border-white/10 mb-5">
                        <img
                          src={webProj.image}
                          alt={webProj.title}
                          loading="lazy"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent opacity-30 group-hover:opacity-10 transition-opacity" />
                      </div>

                      <!-- Title & External Arrow -->
                      <div class="flex items-center justify-between">
                        <h4 class="text-xl font-extrabold text-foreground group-hover:text-blue-400 transition-colors">
                          {webProj.title}
                        </h4>
                        <span class="text-foreground/40 group-hover:text-blue-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300 text-lg font-mono">
                          ↗
                        </span>
                      </div>
                    </div>

                    <!-- Tech Stack Tags -->
                    <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-white/5">
                      {webProj.tags.map((tag) => (
                        <span class="text-[10px] font-mono text-foreground/50 bg-white/5 px-2.5 py-1 rounded-md border border-white/5 font-semibold">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </a>
                </AnimatedContent>
              ))}
            </div>

          </div>
        </div>
      ) : (
        <!-- Items 01, 03, 04 (Clickable for Modal) -->
        <AnimatedContent distance={60} direction="vertical" duration={0.8} threshold={0.15} client:visible>
          <div 
            class="project-trigger group cursor-pointer py-16 md:py-24 hover:bg-white/[0.02] transition-colors duration-500"
            data-project={JSON.stringify(proj)}
          >
            <div class="mx-auto max-w-360 px-6 sm:px-12 lg:px-24 2xl:max-w-450 3xl:max-w-550">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:items-center">
                
                <!-- Image / Video Frame -->
                <div class="relative aspect-4/3 w-full overflow-hidden rounded-[2rem] md:col-span-7 bg-white/5 flex items-center justify-center border border-white/5 shadow-inner">
                  {proj.video ? (
                    <video
                      src={proj.video}
                      autoplay
                      loop
                      muted
                      playsinline
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                    />
                  ) : (
                    <>
                      <div class={`absolute inset-0 bg-gradient-to-tr ${proj.color} opacity-40 group-hover:scale-105 transition-transform duration-700 ease-out`} />
                      <span class="text-white/10 font-mono text-8xl select-none group-hover:scale-110 transition-transform duration-700">{proj.num}</span>
                    </>
                  )}
                  <!-- Subtle hover indicator -->
                  <div class="absolute bottom-4 right-4 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10 text-xs font-mono text-white/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center gap-1.5">
                    <span>Lihat Detail</span>
                    <span>↗</span>
                  </div>
                </div>

                <!-- Project Details -->
                <div class="flex flex-col md:col-span-5 md:pl-8">
                  <span class="text-base font-semibold uppercase tracking-widest text-blue-400 mb-4 font-mono">{proj.num} — {proj.category}</span>
                  <h3 class="text-[clamp(2rem,3.5vw,4rem)] leading-[1.05] tracking-tight text-foreground mb-6 font-extrabold">
                    {proj.title}
                  </h3>
                  <p class="text-foreground/70 text-lg leading-relaxed max-w-md">
                    {proj.desc}
                  </p>
                </div>

              </div>
            </div>
          </div>
        </AnimatedContent>
      )
    ))}
  </div>

  <!-- Project Detail Modal Component -->
  <ProjectModal />
</section>
