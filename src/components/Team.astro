---
import { Image } from "astro:assets";
import team1 from "../assets/team/team1.png";
import team2 from "../assets/team/team2.png";
import team3 from "../assets/team/team3.png";
import team4 from "../assets/team/team4.png";
import team5 from "../assets/team/team5.png";
import team6 from "../assets/team/team6.png";
import team7 from "../assets/team/team7.png";

const team = [
  {
    name: "Sol",
    role: "Co-Founder / CEO",
    tagline:
      "Mengarahkan visi bisnis dan menyusun strategi pertumbuhan brand jangka panjang.",
    image: team1,
  },
  {
    name: "Ame",
    role: "Creative Director",
    tagline:
      "Arsitek ide kreatif di balik konsep konten visual yang estetis dan berkarakter.",
    image: team2,
  },
  {
    name: "Rian",
    role: "Director of Photography",
    tagline:
      "Mengubah ide abstrak menjadi tangkapan visual sinematik kelas atas.",
    image: team3,
  },
  {
    name: "Aru",
    role: "Art Director",
    tagline:
      "Menjaga konsistensi identitas visual dan estetika brand di setiap aset desain.",
    image: team4,
  },
  {
    name: "Ari",
    role: "Lead Video Editor",
    tagline:
      "Menyusun potongan klip menjadi alur cerita video dengan ritme dan transisi dinamis.",
    image: team5,
  },
  {
    name: "Bayu",
    role: "Social Media Manager",
    tagline:
      "Menjaga interaksi audiens tetap aktif dan menganalisis performa data secara real-time.",
    image: team6,
  },
  {
    name: "Incun",
    role: "Lead Scriptwriter",
    tagline:
      "Peracik hook pemikat dan penulisan skrip naratif yang menggerakkan audiens.",
    image: team7,
  },
];
---

<section
  id="about"
  class="py-24 bg-background relative overflow-hidden border-t border-white/5"
>
  <div
    class="px-6 sm:px-12 lg:px-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto relative z-10"
  >
    <!-- Section Header -->
    <div class="max-w-2xl mb-20">
      <span
        class="text-xs uppercase font-mono tracking-widest text-accent font-bold"
        >Orang-Orang di Balik Layar</span
      >
      <h2
        class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground mt-4 leading-none"
      >
        Tim Kreatif Kami
      </h2>
      <p class="text-foreground/70 text-lg sm:text-xl mt-6 leading-relaxed">
        Kombinasi produser visual, penulis skrip, editor, dan analis data yang
        berkolaborasi untuk meroketkan kehadiran brand Anda.
      </p>
    </div>

    <!-- Team Carousel Layout -->
    <div class="relative w-full">
      <!-- Navigation Buttons / Carousel Controls -->
      <div class="flex justify-end gap-3 mb-6 relative z-20">
        <button
          id="prev-btn"
          class="flex items-center justify-center w-12 h-12 rounded-full border border-white/10 bg-white/5 text-foreground hover:bg-white/10 hover:border-white/20 transition-all focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        <button
          id="next-btn"
          class="flex items-center justify-center w-12 h-12 rounded-full border border-white/10 bg-white/5 text-foreground hover:bg-white/10 hover:border-white/20 transition-all focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>

      <!-- Carousel Container -->
      <div
        class="overflow-hidden py-4 select-none relative"
        id="team-carousel"
      >
        <!-- Fade Overlays (Hardware-friendly gradient overlays instead of CSS mask-image) -->
        <div class="absolute left-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-r from-background to-transparent pointer-events-none z-10"></div>
        <div class="absolute right-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-l from-background to-transparent pointer-events-none z-10"></div>

        <div 
          class="flex gap-6 transition-transform duration-500 ease-out" 
          id="team-track"
          style="transform: translate3d(0px, 0px, 0px);"
        >
          {
            team.map((member) => (
              <div class="team-card w-full sm:w-[calc((100%-24px)/2)] md:w-[calc((100%-48px)/3)] lg:w-[calc((100%-72px)/4)] shrink-0 p-3">
                <Image
                  src={member.image}
                  alt={member.name}
                  width={600}
                  height={800}
                  class="w-full h-auto object-contain"
                  draggable="false"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative blur element -->
  <div
    class="absolute right-0 bottom-0 w-96 h-96 bg-accent/5 rounded-full filter blur-[120px] pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute left-0 top-1/2 -translate-y-1/2 w-80 h-80 bg-blue-500/5 rounded-full filter blur-[100px] pointer-events-none z-0"
  >
  </div>
</section>

<script>
  const track = document.getElementById("team-track");
  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");

  if (track && prevBtn && nextBtn) {
    let currentIndex = 0;

    function getItemsPerPage() {
      if (window.innerWidth >= 1024) return 4; // lg
      if (window.innerWidth >= 768) return 3;  // md
      if (window.innerWidth >= 640) return 2;  // sm
      return 1;
    }

    function updateCarousel() {
      const items = track.children;
      if (items.length === 0) return;
      
      const totalItems = items.length;
      const itemsPerPage = getItemsPerPage();
      const maxIndex = Math.max(0, totalItems - itemsPerPage);
      
      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }
      if (currentIndex < 0) {
        currentIndex = 0;
      }

      const itemWidth = items[0].getBoundingClientRect().width;
      const gap = 24; // gap-6 is 24px
      const offset = currentIndex * (itemWidth + gap);
      
      // Use translate3d to force hardware acceleration on iOS Safari
      track.style.transform = `translate3d(-${offset}px, 0px, 0px)`;

      // Enable/disable navigation buttons based on position
      if (currentIndex === 0) {
        prevBtn.classList.add("opacity-40", "cursor-not-allowed");
        prevBtn.setAttribute("disabled", "true");
      } else {
        prevBtn.classList.remove("opacity-40", "cursor-not-allowed");
        prevBtn.removeAttribute("disabled");
      }
      
      if (currentIndex === maxIndex) {
        nextBtn.classList.add("opacity-40", "cursor-not-allowed");
        nextBtn.setAttribute("disabled", "true");
      } else {
        nextBtn.classList.remove("opacity-40", "cursor-not-allowed");
        nextBtn.removeAttribute("disabled");
      }
    }

    prevBtn.addEventListener("click", () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    });

    nextBtn.addEventListener("click", () => {
      const itemsPerPage = getItemsPerPage();
      const maxIndex = Math.max(0, track.children.length - itemsPerPage);
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    });

    // Handle resize
    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateCarousel();
      }, 100);
    });

    // Initial positioning
    setTimeout(updateCarousel, 150);
  }
</script>

<style>
  #team-track {
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Only apply hover styles on devices that support hover (e.g. desktop) to prevent iOS tapping freeze */
  @media (hover: hover) {
    .team-card {
      transition: transform 0.5s ease;
    }
    .team-card:hover {
      transform: translateY(-8px);
    }
  }
</style>
