---
import { Image } from "astro:assets";
import team1 from "../assets/team/team1.png";
import team2 from "../assets/team/team2.png";
import team3 from "../assets/team/team3.png";
import team4 from "../assets/team/team4.png";
import team5 from "../assets/team/team5.png";
import team6 from "../assets/team/team6.png";
import team7 from "../assets/team/team7.png";

const team = [
  {
    name: "Sol",
    role: "Co-Founder / CEO",
    tagline:
      "Mengarahkan visi bisnis dan menyusun strategi pertumbuhan brand jangka panjang.",
    image: team1,
  },
  {
    name: "Ame",
    role: "Creative Director",
    tagline:
      "Arsitek ide kreatif di balik konsep konten visual yang estetis dan berkarakter.",
    image: team2,
  },
  {
    name: "Rian",
    role: "Director of Photography",
    tagline:
      "Mengubah ide abstrak menjadi tangkapan visual sinematik kelas atas.",
    image: team3,
  },
  {
    name: "Aru",
    role: "Art Director",
    tagline:
      "Menjaga konsistensi identitas visual dan estetika brand di setiap aset desain.",
    image: team4,
  },
  {
    name: "Ari",
    role: "Lead Video Editor",
    tagline:
      "Menyusun potongan klip menjadi alur cerita video dengan ritme dan transisi dinamis.",
    image: team5,
  },
  {
    name: "Bayu",
    role: "Social Media Manager",
    tagline:
      "Menjaga interaksi audiens tetap aktif dan menganalisis performa data secara real-time.",
    image: team6,
  },
  {
    name: "Incun",
    role: "Lead Scriptwriter",
    tagline:
      "Peracik hook pemikat dan penulisan skrip naratif yang menggerakkan audiens.",
    image: team7,
  },
];
---

<section
  id="about"
  class="py-24 bg-background relative overflow-hidden border-t border-white/5"
>
  <div
    class="px-6 sm:px-12 lg:px-24 max-w-360 2xl:max-w-450 3xl:max-w-550 mx-auto relative z-10"
  >
    <!-- Section Header -->
    <div class="max-w-2xl mb-20">
      <span
        class="text-xs uppercase font-mono tracking-widest text-accent font-bold"
        >Orang-Orang di Balik Layar</span
      >
      <h2
        class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground mt-4 leading-none"
      >
        Tim Kreatif Kami
      </h2>
      <p class="text-foreground/70 text-lg sm:text-xl mt-6 leading-relaxed">
        Kombinasi produser visual, penulis skrip, editor, dan analis data yang
        berkolaborasi untuk meroketkan kehadiran brand Anda.
      </p>
    </div>

    <!-- Team Carousel Layout -->
    <div
      class="relative w-full overflow-hidden py-4 cursor-grab active:cursor-grabbing select-none mask-fade"
      id="team-carousel"
    >
      <div class="flex gap-6 w-max" id="team-marquee-track">
        <!-- Group 1 -->
        <div class="flex gap-6 shrink-0">
          {
            team.map((member) => (
              <div class="w-[280px] sm:w-[320px] shrink-0 transition-transform duration-500 hover:-translate-y-2 p-3">
                <Image
                  src={member.image}
                  alt={member.name}
                  width={600}
                  height={800}
                  class="w-full h-auto object-contain"
                />
              </div>
            ))
          }
        </div>

        <!-- Group 2 (Duplicate for infinite seamless loop) -->
        <div class="flex gap-6 shrink-0" aria-hidden="true">
          {
            team.map((member) => (
              <div class="w-[280px] sm:w-[320px] shrink-0 transition-transform duration-500 hover:-translate-y-2 p-3">
                <Image
                  src={member.image}
                  alt={member.name}
                  width={600}
                  height={800}
                  class="w-full h-auto object-contain"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative blur element -->
  <div
    class="absolute right-0 bottom-0 w-96 h-96 bg-accent/5 rounded-full filter blur-[120px] pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute left-0 top-1/2 -translate-y-1/2 w-80 h-80 bg-blue-500/5 rounded-full filter blur-[100px] pointer-events-none z-0"
  >
  </div>
</section>

<script>
  const carousel = document.getElementById("team-carousel");
  const track = document.getElementById("team-marquee-track");

  if (carousel && track) {
    const activeTrack = track;
    let position = 0;
    const baseSpeed = 1.0; // base scrolling speed (pixels per frame)
    let currentSpeed = baseSpeed;
    let isHovered = false;

    // Drag states
    let isDragging = false;
    let startX = 0;
    let dragStartPosition = 0;
    let velocity = 0;
    let lastX = 0;

    carousel.addEventListener("mouseenter", () => {
      isHovered = true;
    });

    carousel.addEventListener("mouseleave", () => {
      isHovered = false;
    });

    // Mouse events
    carousel.addEventListener("mousedown", (e) => {
      isDragging = true;
      startX = e.clientX;
      dragStartPosition = position;
      lastX = e.clientX;
      velocity = 0;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - startX;
      velocity = e.clientX - lastX;
      lastX = e.clientX;
      position = dragStartPosition + deltaX;
    });

    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    // Touch events
    carousel.addEventListener("touchstart", (e) => {
      isDragging = true;
      startX = e.touches[0].clientX;
      dragStartPosition = position;
      lastX = e.touches[0].clientX;
      velocity = 0;
    });

    carousel.addEventListener("touchmove", (e) => {
      if (!isDragging) return;
      const deltaX = e.touches[0].clientX - startX;
      velocity = e.touches[0].clientX - lastX;
      lastX = e.touches[0].clientX;
      position = dragStartPosition + deltaX;
    });

    carousel.addEventListener("touchend", () => {
      isDragging = false;
    });

    function animate() {
      const gap = 24;
      const resetPoint = (activeTrack.scrollWidth + gap) / 2;

      if (isDragging) {
        // While dragging, just render the drag position
      } else {
        // Decelerate drag throwing force (inertia)
        if (Math.abs(velocity) > 0.1) {
          position += velocity;
          velocity *= 0.95; // Decay factor
        } else {
          // Resume auto-scroll
          const targetSpeed = isHovered ? 0 : baseSpeed;
          currentSpeed += (targetSpeed - currentSpeed) * 0.05;
          position -= currentSpeed;
        }
      }

      // Loop wrapping for infinite scroll in both directions
      if (position <= -resetPoint) {
        position += resetPoint;
        if (isDragging) dragStartPosition += resetPoint;
      } else if (position >= 0) {
        position -= resetPoint;
        if (isDragging) dragStartPosition -= resetPoint;
      }

      activeTrack.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(animate);
    }

    // Start animation loop
    requestAnimationFrame(animate);
  }
</script>

<style>
  /* Optional fade mask on sides for premium look */
  .mask-fade {
    mask-image: linear-gradient(
      to right,
      transparent,
      white 10%,
      white 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      white 10%,
      white 90%,
      transparent
    );
  }
</style>
