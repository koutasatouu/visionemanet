---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import WebPricing from '../components/WebPricing.astro';
import SocialProof from '../components/SocialProof.astro';
import Team from '../components/Team.astro';
import FaqAccordion from '../components/reactbits/FaqAccordion.tsx';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    question: "Emang apa bedanya Visionema.net sama agensi sosmed lain?",
    answer: "Kita anti banget sama yang namanya 'asal upload terus ditinggal'. Di sini kita kulik target audiens lu, bikin hook skrip yang bikin orang gak scroll ngelewatin, dan racik visual aesthetic yang langsung ngangkat kelas brand lu!"
  },
  {
    question: "Sistem kerja samanya gimana? Harus kontrak panjang?",
    answer: "Sistemnya fleksibel bulanan dengan evaluasi performa bareng di akhir periode. Tapi kita saranin minimal 3 bulan ya, biar racikan strategi dan pertumbuhan grafiknya keliatan nampol!"
  },
  {
    question: "Materi video & foto disiapin dari siapa nih?",
    answer: "Fleksibel banget! Buat tipe video B-Roll aesthetic, kita bisa arahin tim internal lu buat ambil footage praktis via HP dengan arahan angle dari kita, atau kita bantu racik dari stock video berlisensi yang ciamik."
  },
  {
    question: "Dari mulai deal sampe konten pertama tayang butuh berapa lama?",
    answer: "Rata-rata 7–10 hari kerja. Waktu ini kita pake buat riset mendalam, nyusun pilar konten, nulis skrip, dan bikin desain visual terbaik biar pas hari H launching langsung pecah!"
  }
];
---

<Layout>
  <!-- Global navigation header -->
  <Header client:visible />

  <main>
    <!-- Sections -->
    <Hero />
    <Projects />
    <Services />
    <Pricing />
    <WebPricing />
    <SocialProof />
    <Team />

    <!-- Interactive FAQ Section -->
    <section class="bg-background py-24 border-t border-foreground/5">
      <div class="px-6 sm:px-12 lg:px-24 max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs uppercase font-mono tracking-widest text-blue-400 font-bold">Paling Sering Ditanyain</span>
          <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground mt-3">
            Pertanyaan Umum (FAQ)
          </h2>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
