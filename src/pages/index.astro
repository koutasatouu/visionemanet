---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import WebPricing from '../components/WebPricing.astro';
import SocialProof from '../components/SocialProof.astro';
import Team from '../components/Team.astro';
import FaqAccordion from '../components/reactbits/FaqAccordion.tsx';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    question: "Apa yang membedakan Visionema.net dengan agensi media sosial lainnya?",
    answer: "Kami mengedepankan pendekatan strategis dan personalisasi brand. Kami tidak sekadar memposting konten, melainkan melakukan riset target audiens, menyusun naskah dengan hook yang kuat, serta mengeksekusi visual berkualitas tinggi yang memperkuat reputasi brand Anda."
  },
  {
    question: "Bagaimana sistem kerja samanya? Apakah memerlukan kontrak jangka panjang?",
    answer: "Sistem kerja sama kami sangat fleksibel secara bulanan dengan evaluasi berkala di setiap akhir periode. Kami merekomendasikan komitmen minimal 3 bulan agar proses optimasi dan pertumbuhan audiens Anda tercapai secara optimal."
  },
  {
    question: "Bagaimana alur penyediaan materi foto dan video?",
    answer: "Sangat fleksibel. Untuk kebutuhan video B-Roll estetik, kami dapat memandu tim internal Anda dalam pengambilan footage praktis sesuai panduan angle dari kami, atau kami bantu racik menggunakan aset video berlisensi premium."
  },
  {
    question: "Berapa lama waktu yang dibutuhkan hingga konten pertama tayang?",
    answer: "Rata-rata 7–10 hari kerja. Waktu ini kami gunakan untuk riset mendalam, penyusunan pilar konten, penulisan skrip kreatif, serta penyiapan desain visual terbaik sebelum jadwal publikasi perdana dimulai."
  }
];
---

<Layout>
  <!-- Global navigation header -->
  <Header client:visible />

  <main>
    <!-- Sections -->
    <Hero />
    <Projects />
    <Services />
    <Pricing />
    <WebPricing />
    <SocialProof />
    <Team />

    <!-- Interactive FAQ Section -->
    <section class="bg-background py-24 border-t border-foreground/5">
      <div class="px-6 sm:px-12 lg:px-24 max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs uppercase font-mono tracking-widest text-blue-400 font-bold">Paling Sering Ditanyain</span>
          <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground mt-3">
            Pertanyaan Umum (FAQ)
          </h2>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
