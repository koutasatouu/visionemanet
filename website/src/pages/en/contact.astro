---
import MainLayout from '../../layouts/MainLayout.astro';
import ContactForm from '../../components/react/ContactForm.tsx';
import { t } from '../../i18n/translations';
import { SITE, waLink } from '../../config';
const lang = 'en' as const;
---
<MainLayout title="Contact · Visionema.net" description="Tell us about your brand. WhatsApp, Instagram DM, or a quick form." lang={lang} path="/en/contact">
  <section class="section ct-hero">
    <div class="container ct-hero-grid">
      <div>
        <span class="eyebrow">{t.contact.kicker[lang]}</span>
        <h1 class="ct-title">{t.contact.title[lang]}</h1>
        <p class="ct-sub">{t.contact.sub[lang]}</p>

        <div class="ct-channels">
          <div class="ct-ch-h">{t.contact.channels[lang]}</div>
          <a href={waLink()} target="_blank" rel="noopener" class="ct-ch">
            <span class="ct-ch-icon" style="background:#25D366">WA</span>
            <div><div class="ct-ch-name">WhatsApp</div><div class="ct-ch-value">+62 877-2419-9349</div></div>
            <span class="ct-ch-arrow">↗</span>
          </a>
          <a href={SITE.instagram} target="_blank" rel="noopener" class="ct-ch">
            <span class="ct-ch-icon" style="background:linear-gradient(135deg,#EF2A2A,#FFCC00,#33CCFF)">IG</span>
            <div><div class="ct-ch-name">Instagram</div><div class="ct-ch-value">@visionema_net</div></div>
            <span class="ct-ch-arrow">↗</span>
          </a>
          <a href={`mailto:${SITE.email}`} class="ct-ch">
            <span class="ct-ch-icon" style="background:#1E56E8">@</span>
            <div><div class="ct-ch-name">Email</div><div class="ct-ch-value">{SITE.email}</div></div>
            <span class="ct-ch-arrow">↗</span>
          </a>
        </div>
      </div>

      <div class="ct-form-wrap">
        <div class="ct-form-h">Or fill this form</div>
        <ContactForm client:load lang={lang} />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .ct-hero { padding-top: 80px; padding-bottom: 120px; background: linear-gradient(180deg, #0B0F1A, #0A1F5B); min-height: 90vh; }
  .ct-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .ct-title { font-size: clamp(56px, 11vw, 160px); letter-spacing: -0.04em; white-space: pre-line; line-height: 0.9; margin-top: 16px; }
  .ct-sub { font-size: 18px; opacity: 0.75; margin-top: 20px; max-width: 420px; }
  .ct-channels { margin-top: 40px; display: flex; flex-direction: column; gap: 12px; }
  .ct-ch-h { font-family: var(--font-display); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.5; margin-bottom: 6px; }
  .ct-ch { display: grid; grid-template-columns: 52px 1fr auto; gap: 14px; align-items: center; padding: 16px 20px; border-radius: 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); transition: transform .2s, background .2s; }
  .ct-ch:hover { transform: translateX(6px); background: rgba(255,255,255,0.08); }
  .ct-ch-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 14px; }
  .ct-ch-name { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .ct-ch-value { font-size: 13px; opacity: 0.55; }
  .ct-ch-arrow { font-size: 20px; opacity: 0.5; }
  .ct-form-wrap { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); border-radius: 28px; padding: 34px; }
  .ct-form-h { font-family: var(--font-display); font-weight: 700; font-size: 24px; margin-bottom: 20px; }
  @media (max-width: 900px) { .ct-hero-grid { grid-template-columns: 1fr; gap: 40px; } .ct-hero { padding-bottom: 60px; } }
</style>
