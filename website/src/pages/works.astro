---
import MainLayout from '../layouts/MainLayout.astro';
import { works } from '../data/works';
import { t, type Lang } from '../i18n/translations';
import FinalCTA from '../components/FinalCTA.astro';
const lang: Lang = 'id';
---
<MainLayout title="Karya · Visionema.net" description="Portfolio & showcase konten Visionema.net. Konten sosmed, campaign, dan reels dari brand-brand yang kami handle." lang={lang} path="/works">

  <section class="section w-hero">
    <div class="container">
      <span class="eyebrow">{t.worksPage.kicker[lang]}</span>
      <h1 class="w-hero-title">{t.worksPage.title[lang]}</h1>
      <p class="w-hero-sub">{t.worksPage.sub[lang]}</p>
    </div>
  </section>

  <section class="section w-grid-wrap">
    <div class="container">
      <div class="w-grid">
        {works.map((w, i) => (
          <a href="#" class:list={["w-card", `s-${w.size}`]} data-testid={`works-page-card-${w.id}`}>
            <div class="w-img" style={`background-image:url(${w.image})`}>
              <span class="w-idx" style={`background:${w.accent};color:${w.accent === '#FFCC00' ? '#0B0F1A' : '#fff'}`}>{String(i + 1).padStart(2, '0')}</span>
              {w.isPlaceholder && <span class="w-holder">Placeholder · replace with client visual</span>}
            </div>
            <div class="w-meta">
              <div class="w-client">{w.client}</div>
              <div class="w-service">{w.service[lang]} · {w.year}</div>
            </div>
          </a>
        ))}
      </div>

      <div class="w-note">
        {lang === 'id'
          ? '☝ Semua thumbnail di atas adalah placeholder. Konten aslinya akan diganti dengan karya-karya Visionema.net.'
          : '☝ Every thumbnail above is a placeholder. Actual Visionema.net client work will replace them.'}
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} />
</MainLayout>

<style>
  .w-hero { padding-top: 80px; background: linear-gradient(180deg, #0B0F1A, #14192A); }
  .w-hero-title { font-size: clamp(48px, 10vw, 160px); letter-spacing: -0.03em; white-space: pre-line; margin-top: 16px; }
  .w-hero-sub { max-width: 560px; margin-top: 20px; opacity: 0.7; font-size: 17px; }

  .w-grid-wrap { background: var(--brand-ink); padding-top: 40px; }
  .w-grid { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-flow: dense; gap: 16px; }
  .w-card { display: block; transition: transform .3s; }
  .w-card:hover { transform: translateY(-4px); }
  .s-tall { grid-column: span 2; grid-row: span 2; }
  .s-square { grid-column: span 2; }
  .s-wide { grid-column: span 3; }
  .w-img { position: relative; background-size: cover; background-position: center; background-color: #1E56E8; border-radius: 20px; overflow: hidden; aspect-ratio: 4/5; }
  .s-square .w-img { aspect-ratio: 1/1; }
  .s-wide .w-img { aspect-ratio: 16/9; }
  .s-tall .w-img { aspect-ratio: 4/6.5; }
  .w-idx { position: absolute; top: 14px; left: 14px; padding: 6px 12px; border-radius: 999px; font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: 0.08em; }
  .w-holder { position: absolute; bottom: 14px; left: 14px; padding: 4px 10px; border-radius: 999px; background: rgba(0,0,0,0.6); color: #fff; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .w-meta { padding: 12px 4px 0; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .w-client { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  .w-service { font-size: 13px; opacity: 0.55; }
  .w-note { margin-top: 40px; padding: 20px 24px; border-radius: 16px; background: rgba(255,204,0,0.08); border: 1px dashed rgba(255,204,0,0.35); color: #FFCC00; font-size: 14px; }

  @media (max-width: 900px) {
    .w-grid { grid-template-columns: repeat(2, 1fr); }
    .s-tall, .s-square, .s-wide { grid-column: span 1; grid-row: span 1; }
    .s-wide { grid-column: span 2; }
    .s-tall .w-img, .s-square .w-img, .s-wide .w-img { aspect-ratio: 4/5; }
    .s-wide .w-img { aspect-ratio: 16/9; }
  }
</style>
