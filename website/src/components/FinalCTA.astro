---
import { t, type Lang } from '../i18n/translations';
import { waLink, SITE } from '../config';
import MagneticButton from './react/MagneticButton.tsx';
export interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="section final">
  <div class="container">
    <div class="final-inner">
      <div class="final-eyebrow">✦ {lang === 'id' ? 'Satu chat, satu langkah.' : 'One chat, one step.'}</div>
      <h2 class="final-title">
        <span>{t.finalCta.line1[lang]}</span><br/>
        <span class="curly">{t.finalCta.line2[lang]}</span>
      </h2>
      <div class="final-cta">
        <MagneticButton client:load href={waLink()} target="_blank" testId="final-cta-wa" className="btn btn-primary big">
          {t.finalCta.button[lang]} <span aria-hidden="true">→</span>
        </MagneticButton>
      </div>
      <div class="final-sub">{t.finalCta.sub[lang]}</div>
      <div class="final-channels">
        <a href={waLink()} target="_blank" rel="noopener" class="fch">WhatsApp <span>↗</span></a>
        <a href={SITE.instagram} target="_blank" rel="noopener" class="fch">Instagram <span>↗</span></a>
        <a href={`mailto:${SITE.email}`} class="fch">Email <span>↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .final { background: var(--brand-blue); position: relative; overflow: hidden; }
  .final::before { content: 'SHINE'; position: absolute; top: -30px; left: -30px; font-family: var(--font-display); font-weight: 700; font-size: clamp(180px, 26vw, 400px); color: rgba(255,255,255,0.06); letter-spacing: -0.04em; pointer-events: none; }
  .final::after { content: 'GROW'; position: absolute; bottom: -60px; right: -30px; font-family: var(--font-serif); font-style: italic; font-size: clamp(180px, 26vw, 400px); color: rgba(255,204,0,0.15); pointer-events: none; }
  .final-inner { position: relative; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 60px 0; }
  .final-eyebrow { padding: 8px 18px; border-radius: 999px; background: rgba(0,0,0,0.2); font-family: var(--font-display); font-size: 13px; }
  .final-title { font-size: clamp(48px, 9vw, 130px); letter-spacing: -0.03em; line-height: 0.95; }
  .curly { font-family: var(--font-serif); font-style: italic; color: var(--brand-yellow); font-weight: 400; }
  .final-cta .big { padding: 22px 34px; font-size: 18px; }
  .final-sub { opacity: 0.75; font-size: 15px; }
  .final-channels { display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap; justify-content: center; }
  .fch { font-family: var(--font-display); font-weight: 600; font-size: 15px; padding: 10px 18px; border-radius: 999px; background: rgba(0,0,0,0.15); }
  .fch:hover { background: #0B0F1A; }
</style>
