---
import { t, type Lang } from '../i18n/translations';
import { waLink } from '../config';
import RotatingWord from './react/RotatingWord.tsx';
import MagneticButton from './react/MagneticButton.tsx';

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---
<section class="hero" data-testid="hero-section">
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="orb orb-c"></div>
    <div class="grid-lines"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-left">
      <span class="eyebrow">{t.hero.kicker[lang]}</span>

      <h1 class="hero-title">
        <span class="line">{t.hero.title1[lang]}</span>
        <span class="line rotate-line"><RotatingWord client:load /></span>
        <span class="line handdraw">online.</span>
      </h1>

      <p class="hero-sub">{t.hero.sub[lang]}</p>

      <div class="hero-cta">
        <MagneticButton client:load href={waLink()} target="_blank" testId="hero-cta-wa" className="btn btn-primary">
          {t.hero.cta1[lang]} <span aria-hidden="true">→</span>
        </MagneticButton>
        <a href={prefix + '/works'} class="btn btn-ghost" data-testid="hero-cta-works">
          {t.hero.cta2[lang]} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="hero-meta">
        <div>
          <div class="k">352<span>+</span></div>
          <div class="l">Followers · @visionema_net</div>
        </div>
        <div>
          <div class="k">Magelang</div>
          <div class="l">{lang === 'id' ? 'Basis studio' : 'Studio base'}</div>
        </div>
        <div>
          <div class="k">SMM · Content · Design</div>
          <div class="l">{lang === 'id' ? 'Layanan utama' : 'Core services'}</div>
        </div>
      </div>
    </div>

    <div class="hero-right" aria-hidden="true">
      <div class="phone">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="ig-header">
            <div class="ig-avatar"></div>
            <div>
              <div class="ig-name">visionema_net</div>
              <div class="ig-loc">Magelang · Indonesia</div>
            </div>
          </div>
          <div class="ig-grid">
            <div class="tile t1"><span>SHINE</span></div>
            <div class="tile t2"><span>Sekar</span></div>
            <div class="tile t3"><span>?</span></div>
            <div class="tile t4"><span>Now Open</span></div>
            <div class="tile t5"><span>Reels</span></div>
            <div class="tile t6"><span>@visionema_net</span></div>
          </div>
        </div>
      </div>
      <div class="sticker sticker-a">✦ Start</div>
      <div class="sticker sticker-b">Grow →</div>
      <div class="sticker sticker-c">WIN!</div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{t.hero.ticker[lang]}</span>
      <span>{t.hero.ticker[lang]}</span>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: 100px 0 0; overflow: hidden; background: linear-gradient(180deg, #0B0F1A 0%, #0A1F5B 100%); }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; filter: blur(80px); }
  .orb-a { width: 500px; height: 500px; background: #1E56E8; opacity: 0.5; top: -100px; left: -80px; }
  .orb-b { width: 400px; height: 400px; background: #33CCFF; opacity: 0.35; top: 40%; right: -80px; }
  .orb-c { width: 300px; height: 300px; background: #FFCC00; opacity: 0.18; bottom: -80px; left: 30%; }
  .grid-lines {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at 60% 40%, black 40%, transparent 80%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 90px;
  }
  .hero-left { display: flex; flex-direction: column; gap: 26px; }
  .hero-title { font-size: clamp(48px, 8.5vw, 128px); line-height: 0.92; }
  .hero-title .line { display: block; }
  .handdraw { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--brand-yellow); display: inline-block; transform: rotate(-2deg); }
  .hero-sub { max-width: 480px; font-size: 17px; line-height: 1.6; opacity: 0.75; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  .hero-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 30px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-meta .k { font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: -0.02em; }
  .hero-meta .k span { color: var(--brand-yellow); }
  .hero-meta .l { font-size: 12px; opacity: 0.55; margin-top: 4px; }

  .hero-right { position: relative; display: flex; justify-content: center; }
  .phone { width: 280px; height: 560px; background: #14192A; border: 8px solid #050810; border-radius: 42px; padding: 12px 10px; position: relative; box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 0 0 2px rgba(255,255,255,0.05); transform: rotate(-4deg); }
  .phone-notch { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 90px; height: 22px; background: #050810; border-radius: 12px; }
  .phone-screen { border-radius: 30px; overflow: hidden; height: 100%; background: linear-gradient(#0B0F1A, #0A1F5B); padding: 42px 12px 12px; display: flex; flex-direction: column; gap: 12px; }
  .ig-header { display: flex; align-items: center; gap: 10px; padding: 4px 6px; }
  .ig-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #33CCFF, #1E56E8); border: 2px solid #FFCC00; }
  .ig-name { font-family: var(--font-display); font-weight: 700; font-size: 14px; }
  .ig-loc { font-size: 10px; opacity: 0.5; }
  .ig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; flex: 1; }
  .tile { border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 13px; text-align: center; padding: 6px; }
  .tile.t1 { background: linear-gradient(135deg, #1E56E8, #33CCFF); }
  .tile.t2 { background: #14192A; border: 1px solid rgba(255,255,255,0.1); color: #FFCC00; font-style: italic; font-family: var(--font-serif); font-size: 16px; }
  .tile.t3 { background: #FFCC00; color: #0B0F1A; font-size: 24px; }
  .tile.t4 { background: #EF2A2A; }
  .tile.t5 { background: #0A1F5B; border: 1px solid #33CCFF; color: #33CCFF; }
  .tile.t6 { background: linear-gradient(135deg, #33CCFF, #1E56E8); font-size: 10px; }

  .sticker { position: absolute; padding: 10px 16px; border-radius: 999px; background: #FFCC00; color: #0B0F1A; font-family: var(--font-display); font-weight: 700; font-size: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); animation: float 4s ease-in-out infinite; }
  .sticker-a { top: 10%; left: -20px; transform: rotate(-8deg); }
  .sticker-b { top: 40%; right: -30px; background: #33CCFF; transform: rotate(6deg); animation-delay: -1.5s; }
  .sticker-c { bottom: 12%; left: -10px; background: #EF2A2A; color: #fff; transform: rotate(-10deg); animation-delay: -2.8s; }
  @keyframes float { 0%,100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-10px) rotate(-4deg); } }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 40px; padding-bottom: 60px; }
    .hero-right { order: -1; transform: scale(0.85); }
    .hero-meta { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .hero-title { font-size: clamp(44px, 13vw, 72px); }
    .hero-cta .btn { flex: 1; justify-content: center; }
  }
</style>
