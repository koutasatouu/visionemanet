---
import { t, type Lang } from '../i18n/translations';
export interface Props { lang: Lang; }
const { lang } = Astro.props;

const tiles = [
  { kind: 'quote', text: { id: '"Konsisten posting selama 3 bulan, followers naik dan DM masuk terus."', en: '"Consistent posting for 3 months, followers grew and DMs kept coming."' }, author: 'Owner · Sekar Aroma' },
  { kind: 'stat', big: '8→20', small: { id: 'Video per bulan setelah upgrade paket', en: 'Videos/month after upgrading' } },
  { kind: 'reel', label: 'Reel · SHINE SHINE SHINE', bg: 'linear-gradient(135deg,#1E56E8,#33CCFF)' },
  { kind: 'quote', text: { id: '"Feed jadi rapi, orang jadi percaya sama brand-nya."', en: '"The feed looks clean, people started trusting the brand."' }, author: 'Founder · Warung Sinar' },
  { kind: 'stat', big: '4x', small: { id: 'Engagement rate rata-rata brand kami', en: 'Average engagement rate uplift' } },
  { kind: 'reel', label: 'Carousel · Instagram Hack', bg: 'linear-gradient(135deg,#FFCC00,#EF2A2A)' },
];
---
<section class="section proof">
  <div class="container proof-head">
    <span class="eyebrow">{t.proof.label[lang]}</span>
    <h2 class="proof-title">{t.proof.title[lang]}</h2>
  </div>
  <div class="container">
    <div class="proof-grid">
      {tiles.map((tile) => (
        <div class:list={["proof-tile", `t-${tile.kind}`]} style={tile.kind === 'reel' ? `background:${(tile as any).bg}` : ''}>
          {tile.kind === 'quote' && (
            <>
              <div class="tq-mark">"</div>
              <p class="tq-text">{(tile as any).text[lang]}</p>
              <div class="tq-author">— {(tile as any).author}</div>
            </>
          )}
          {tile.kind === 'stat' && (
            <>
              <div class="ts-big">{(tile as any).big}</div>
              <div class="ts-small">{(tile as any).small[lang]}</div>
            </>
          )}
          {tile.kind === 'reel' && (
            <>
              <div class="tr-label">{(tile as any).label}</div>
              <svg class="tr-play" width="42" height="42" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .proof { background: var(--brand-ink); }
  .proof-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; align-items: flex-start; }
  .proof-title { font-size: clamp(36px, 6vw, 72px); white-space: pre-line; }
  .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .proof-tile { aspect-ratio: 1 / 1; border-radius: 24px; padding: 26px; overflow: hidden; position: relative; display: flex; flex-direction: column; justify-content: space-between; }
  .t-quote { background: #FFF9DE; color: #0B0F1A; }
  .tq-mark { font-family: var(--font-serif); font-size: 100px; line-height: 0.6; color: var(--brand-red); }
  .tq-text { font-family: var(--font-display); font-weight: 600; font-size: 20px; letter-spacing: -0.01em; line-height: 1.25; }
  .tq-author { font-size: 13px; opacity: 0.6; }
  .t-stat { background: #0A1F5B; color: #fff; }
  .ts-big { font-family: var(--font-display); font-weight: 700; font-size: clamp(64px, 8vw, 110px); letter-spacing: -0.04em; color: #FFCC00; line-height: 1; }
  .ts-small { max-width: 200px; opacity: 0.7; }
  .t-reel { color: #fff; }
  .tr-label { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  .tr-play { align-self: flex-end; }
  @media (max-width: 720px) { .proof-grid { grid-template-columns: 1fr 1fr; } }
</style>
